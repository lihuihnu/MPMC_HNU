{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "ad-debug",
      "displayName": "AD debug tests (default platform generator)",
      "binaryDir": "${sourceDir}/build/ad-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON" }
    },
    {
      "name": "flash-libraries",
      "displayName": "AD, thermodynamics and flash library targets (no tests)",
      "binaryDir": "${sourceDir}/build/flash-libraries",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "MPMC_ENABLE_THERMODYNAMICS": "OFF",
        "MPMC_ENABLE_FLASH": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "ad-debug", "configurePreset": "ad-debug", "configuration": "Debug" },
    { "name": "flash-libraries", "configurePreset": "flash-libraries", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "ad-debug",
      "configurePreset": "ad-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
