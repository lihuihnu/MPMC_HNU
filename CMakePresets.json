{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "ad-debug",
      "displayName": "AD debug tests (default platform generator)",
      "binaryDir": "${sourceDir}/build/ad-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "ad-debug", "configurePreset": "ad-debug", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "ad-debug",
      "configurePreset": "ad-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
